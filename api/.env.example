# Copy to .env for local development (this file is committed; .env is git-ignored).

# --- Database ---
# Owner/superuser connection. Used for migrations and the seed script (DDL +
# cross-tenant writes). On Railway this is the provided DATABASE_URL.
DATABASE_URL=postgres://pps:pps@localhost:5432/pps_retail

# Runtime connection for the API. MUST be a NON-superuser role for Postgres RLS
# to actually take effect (superusers/owners bypass RLS). The enable_rls
# migration creates this "app_user" role for local dev. If unset, the API falls
# back to DATABASE_URL and logs a warning that RLS is not enforced.
APP_DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:5432/pps_retail

# --- Auth ---
JWT_SECRET=dev-only-change-me

# --- Server ---
# Railway injects PORT in production; do not set it there.
PORT=3000
# development | production
NODE_ENV=development

# Root domain for tenant subdomain resolution.
#   <slug>.ROOT_DOMAIN        -> that company (e.g. demo.yourapp.local)
#   admin.ROOT_DOMAIN         -> platform admin context
# Use yourapp.local in dev (with hosts-file entries), yourapp.com in prod.
ROOT_DOMAIN=yourapp.local

# --- Email (invitations) ---
# Provider selection happens in exactly one place (api/src/mail/mail.module.ts).
# MAIL_PROVIDER = postmark | resend | console. Precedence:
#   1. MAIL_MODE=console       -> console, whatever MAIL_PROVIDER says (kill switch)
#   2. MAIL_PROVIDER set       -> that provider; falls back to console (with a
#                                 warning) if its token is missing
#   3. MAIL_MODE=live (legacy) -> resend, the pre-MAIL_PROVIDER behaviour
#   4. nothing set             -> console
# Console mode logs the full email — including a working accept URL — and sends
# nothing, so local dev and automated tests need no credentials.
MAIL_PROVIDER=console

# Sender. MUST be a verified sender signature (or on a verified domain) in
# whichever provider is active, or every send is rejected.
MAIL_FROM="PPS Retail Inventory <onboarding@resend.dev>"

# --- Postmark (CURRENT PRODUCTION PROVIDER) ---
# Server API Token: Postmark -> your Server -> API Tokens. It is per-server, NOT
# the Account token. Invitations are transactional: keep the stream a
# transactional one ("outbound"), never a broadcast stream.
# Example live setup:
#   MAIL_PROVIDER=postmark
#   MAIL_FROM="PPS Retail Inventory <noreply@provisionprocessingsystem.com>"
#   POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# --- Resend (alternative provider, retained) ---
# Example live setup:
#   MAIL_PROVIDER=resend
#   MAIL_FROM="PPS Retail Inventory <onboarding@resend.dev>"   # sandbox sender
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The resend.dev sandbox sender only delivers to the address on the Resend
# account; other recipients are recorded as FAILED with a sandbox-specific reason
# (copy the link from the admin list instead).
RESEND_API_KEY=

# Legacy switch, still honoured: console forces console mode; live means resend
# when MAIL_PROVIDER is unset. Prefer MAIL_PROVIDER for new setups.
MAIL_MODE=

# Test seams only: override a provider's send endpoint so failure paths can be
# exercised against a stub. Leave both unset in production.
RESEND_API_URL=
POSTMARK_API_URL=

# Optional origin override for the invitation accept URL. Normally the link is
# built as https://{companySlug}.{ROOT_DOMAIN}/accept-invite?token=…; set this for
# localhost testing where subdomains are awkward (e.g. http://localhost:4200).
APP_BASE_URL=
